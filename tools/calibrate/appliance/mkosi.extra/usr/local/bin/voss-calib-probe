#!/bin/sh
# Appliance one-shot probe (docs/handoff/CALIBRATION_DATA_CONTRACT.md §3): per-step boot stamps, one TPM attestation
# round, one local mutual-TLS handshake, idle memory and cache size, then systemd-analyze and a reboot back.
# VOSS_T lines are seconds since kernel start (/proc/uptime or a unit's monotonic timestamp); VOSS_U lines are
# microsecond durations read from the boot loader's EFI variables; VOSS_V lines are sizes. A step whose evidence is
# missing is logged as "none" and never estimated. tools/calibrate/suites/appliance.py parses this log.
set -u
LOG_DEV=/dev/disk/by-label/VOSS-LOG
mkdir -p /mnt/voss-log && mount "$LOG_DEV" /mnt/voss-log || exit 1
n=$(ls /mnt/voss-log/appliance-*.log 2>/dev/null | wc -l)
log=/mnt/voss-log/$(printf 'appliance-%04d.log' "$n")
t() { echo "VOSS_T $1 $(cut -d' ' -f1 /proc/uptime)" >> "$log"; }
EFIV=4a67b082-0a4c-41cf-b6c7-440b29bb8c4f   # systemd-boot loader interface GUID
efi() {  # LoaderTimeInitUSec / LoaderTimeExecUSec: UTF-16 decimal microseconds after a 4-byte attribute header
  f=/sys/firmware/efi/efivars/$1-$EFIV
  if [ -r "$f" ]; then echo "VOSS_U $1 $(tail -c +5 "$f" | tr -d '\000')" >> "$log"; else echo "VOSS_U $1 none" >> "$log"; fi
}
unit() {  # seconds since kernel start at which a unit became active
  us=$(systemctl show -p ActiveEnterTimestampMonotonic --value "$2" 2>/dev/null)
  if [ -n "$us" ] && [ "$us" != "0" ]; then echo "VOSS_T $1 $(awk -v u="$us" 'BEGIN{printf "%.6f", u/1e6}')" >> "$log"
  else echo "VOSS_T $1 none" >> "$log"; fi
}
t agent_start
efi LoaderTimeInitUSec
efi LoaderTimeExecUSec
unit initrd_done initrd-switch-root.target
unit verity_ready systemd-veritysetup@root.service
unit cache_unsealed systemd-cryptsetup@cache.service
unit services_ready multi-user.target
w=$(mktemp -d)
tpm2_createek -c "$w/ek.ctx" -G rsa -u "$w/ek.pub" >/dev/null
tpm2_createak -C "$w/ek.ctx" -c "$w/ak.ctx" -G rsa -g sha256 -s rsassa -u "$w/ak.pub" -n "$w/ak.name" >/dev/null
t quote_start
nonce=$(openssl rand -hex 16)
tpm2_quote -c "$w/ak.ctx" -l sha256:0,1,2,3,4,5,6,7,10,11 -q "$nonce" -m "$w/q.msg" -s "$w/q.sig" -o "$w/q.pcrs" -g sha256 >/dev/null
t quote_done
tpm2_checkquote -u "$w/ak.pub" -m "$w/q.msg" -s "$w/q.sig" -f "$w/q.pcrs" -g sha256 -q "$nonce" >/dev/null && t verifier_ok
# session certificate and first mutual-TLS connection (local server: network excluded, as in the contract)
openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 1 -subj /CN=voss -keyout "$w/k.pem" -out "$w/c.pem" 2>/dev/null
t cert_installed
openssl s_server -accept 4433 -cert "$w/c.pem" -key "$w/k.pem" -Verify 1 -CAfile "$w/c.pem" -naccept 1 -quiet >/dev/null 2>&1 &
sleep 0.2
t tls_start
echo | openssl s_client -connect 127.0.0.1:4433 -cert "$w/c.pem" -key "$w/k.pem" -CAfile "$w/c.pem" -quiet >/dev/null 2>&1 && t first_tls
echo "VOSS_V image_mem_mb $(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{printf "%.1f", (t-a)/1024}' /proc/meminfo)" >> "$log"
echo "VOSS_V image_cache_bytes $(df -B1 --output=size /var/cache/voss 2>/dev/null | tail -1 | tr -d ' ' || echo none)" >> "$log"
until systemd-analyze >> "$log" 2>/dev/null; do sleep 1; done
sync
umount /mnt/voss-log
systemctl reboot
